# Configurações do Banco de Dados MySQL
DB_DATABASE=monica
DB_USERNAME=monica_user
DB_PASSWORD=senha_segura_banco
MYSQL_ROOT_PASSWORD=senha_root_banco

# Configurações do Monica HQ
APP_KEY=base64:4T3x9kLqZ1mP8vW2yX0jR5nS7uA6cB1dE8fG9hI0jK1=
APP_URL=http://localhost:8080

#DB_DATABASE: Nome do banco de dados que o MySQL criará para o Monica.

#DB_USERNAME e DB_PASSWORD: Usuário e senha comuns para o Monica acessar o banco.

#MYSQL_ROOT_PASSWORD: Senha de administrador ("root") do MySQL.

#APP_KEY: Chave secreta que o Monica exige para criptografar senhas e sessões do sistema.

#APP_URL: O endereço que usaremos no navegador para acessar o Monica (porta 8080 do localhost).